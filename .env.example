APP_ENV=development
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSLMODE=
LOCAL_POSTGRES_PORT=5435
LOCAL_POSTGRES_USER=ams_data_hub_local
LOCAL_POSTGRES_PASSWORD=
TEST_DATABASE_HOST=127.0.0.1
TEST_DATABASE_PORT=5435
TEST_DATABASE_USER=ams_data_hub_test
TEST_DATABASE_PASSWORD=
TEST_DATABASE_NAME=ams_data_hub_test
TEST_DATABASE_SSLMODE=disable
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Required for production with Better Auth. Enter only the
# exact reverse-proxy IPs/CIDRs after the deployment topology is approved.
BETTER_AUTH_TRUSTED_PROXY_CIDRS=
# Required in production for PLATFORM_ADMIN; local/test may set false explicitly.
ADMIN_TOTP_REQUIRED=
# Client identities remain unable to sign in until this is explicitly enabled.
CLIENT_ACCESS_ENABLED=false
RELEASE_SHA=
OUTBOX_WORKER_ID=
OUTBOX_POLL_DELAY_MS=5000
OUTBOX_SHUTDOWN_DRAIN_TIMEOUT_MS=30000
LOG_LEVEL=info
PGBOSS_SCHEMA=pgboss
PGBOSS_RUNTIME_ROLE=ams_data_hub_worker
# Production-only controlled role bootstrap. Values belong in the dedicated
# root-owned bootstrap env, never in the application env or Git.
DB_BOOTSTRAP_ADMIN_DATABASE_URL=
DB_BOOTSTRAP_EXPECTED_DATABASE=
AMS_DATA_HUB_WEB_DB_PASSWORD=
AMS_DATA_HUB_WORKER_DB_PASSWORD=
AMS_DATA_HUB_BACKUP_DB_PASSWORD=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
REQUIRE_OFFSITE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
