APP_ENV=development
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSLMODE=
LOCAL_POSTGRES_PORT=5435
LOCAL_POSTGRES_USER=ams_data_hub_local
LOCAL_POSTGRES_PASSWORD=
TEST_DATABASE_HOST=127.0.0.1
TEST_DATABASE_PORT=5435
TEST_DATABASE_USER=ams_data_hub_test
TEST_DATABASE_PASSWORD=
TEST_DATABASE_NAME=ams_data_hub_test
TEST_DATABASE_SSLMODE=disable
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Required for production with Better Auth. Enter only the
# exact reverse-proxy IPs/CIDRs after the deployment topology is approved.
BETTER_AUTH_TRUSTED_PROXY_CIDRS=
# Client identities remain unable to sign in until this is explicitly enabled.
CLIENT_ACCESS_ENABLED=false
RELEASE_SHA=
OUTBOX_WORKER_ID=
OUTBOX_POLL_DELAY_MS=5000
OUTBOX_SHUTDOWN_DRAIN_TIMEOUT_MS=30000
LOG_LEVEL=info
PGBOSS_SCHEMA=pgboss
PGBOSS_RUNTIME_ROLE=ams_data_hub_worker
# Production-only controlled role bootstrap. Values belong in the dedicated
# root-owned bootstrap env, never in the application env or Git.
DB_BOOTSTRAP_ADMIN_DATABASE_URL=
DB_BOOTSTRAP_EXPECTED_DATABASE=
AMS_DATA_HUB_WEB_DB_PASSWORD=
AMS_DATA_HUB_WORKER_DB_PASSWORD=
AMS_DATA_HUB_BACKUP_DB_PASSWORD=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
# Explicit value-free per-project binding registry; no implicit global fallback.
# Each entry names organizationId/projectId and bucketRef/endpointRef/regionRef/
# accessKeyIdRef/secretAccessKeyRef. Actual values stay in approved environment.
PROJECT_STORAGE_BINDINGS=
# Optional capability of the existing combined source worker, disabled by default.
SNAPSHOT_BUILD_ENABLED=false
SNAPSHOT_PUBLISH_ENABLED=false
SNAPSHOT_ROLLBACK_ENABLED=false
ACK_ROTATION_ENABLED=false
SNAPSHOT_WEBHOOK_ENABLED=false
# Exact organizationId/projectId/endpointRef registry; HTTPS URL values stay in environment.
# No query credentials, redirects or datasets. Missing project bindings defer; polling remains available.
PROJECT_SNAPSHOT_WEBHOOK_BINDINGS=[]
PROJECT_ACK_ROTATION_BINDINGS=[]
# Value-free per-project signing registry: organizationId/projectId/keyId,
# privateKeyRef/currentKeyId/nextKeyId/revokedKeyIds/publicKeyRefs (keyId -> env name).
# Actual signing/private keys are supplied only through the approved environment.
# Public-only PUBLISH uses the same registry, but keyId/privateKeyRef are optional
# and never resolved. It reads only publicKeyRefs; private PEM in a public slot is rejected.
PROJECT_SNAPSHOT_SIGNING_BINDINGS=
# S3 is disabled until ADR-015's non-production A-to-B denial proof exists.
# Browser delivery, when enabled, uses a server-issued short-lived presigned URL.
S3_PRESIGN_TTL_SECONDS=300
REQUIRE_OFFSITE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Explicit local-only proof for ADR-015. These non-production test credentials
# must differ, have access only to their respective private buckets, and are
# never read unless TIMEWEB_S3_ISOLATION_TEST=nonproduction is set.
TIMEWEB_S3_ISOLATION_TEST=
S3_TEST_ENDPOINT=
S3_TEST_REGION=
S3_TEST_BUCKET_A=
S3_TEST_BUCKET_B=
S3_TEST_ACCESS_KEY_ID_A=
S3_TEST_SECRET_ACCESS_KEY_A=
S3_TEST_ACCESS_KEY_ID_B=
S3_TEST_SECRET_ACCESS_KEY_B=
