generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  PLATFORM_ADMIN
  USER
}

enum MembershipRole {
  ORG_ADMIN
  ORG_EDITOR
  ORG_VIEWER
}

enum ProjectMemberRole {
  PROJECT_EDITOR
  PROJECT_VIEWER
}

enum AuditActorType {
  USER
  SYSTEM
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER
}

enum JobRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum RetentionRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum ProjectStatus {
  ACTIVE
  PLANNED
  DISABLED
}

enum NotificationCategory {
  SYSTEM
  PROJECT
  ACCESS
  QUEUE
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationVisibility {
  PLATFORM_TEAM
  PLATFORM_ADMIN_ONLY
}

enum CatalogLifecycleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ConstructionStatus {
  PLANNED
  UNDER_CONSTRUCTION
  COMPLETED
  SUSPENDED
}

model User {
  id                String             @id
  name              String
  username          String?            @unique
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  twoFactorEnabled  Boolean            @default(false)
  failedLoginCount  Int                @default(0)
  loginLockedUntil  DateTime?          @db.Timestamptz(3)
  setupCompletedAt  DateTime?
  systemRole        SystemRole         @default(USER)
  disabledAt        DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  members           Member[]
  projectMembers    ProjectMember[]
  notificationReads NotificationRead[]
  twoFactors        TwoFactor[]
  setupTokens       AccountSetupToken[]
  recoveryTokens    PlatformRecoveryToken[]

  @@index([loginLockedUntil])
}

enum ProjectServiceState {
  ACTIVE
  SUSPENDED
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([secret])
  @@index([userId])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model AccountSetupToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
}

model PlatformRecoveryToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id           String   @id
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  activeTeamId String?
  activeOrganizationId String?
  twoFactorVerifiedAt DateTime?
  setupCompletedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
}

model Account {
  id                    String    @id
  userId                String
  issuer                String?
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  logo            String?
  metadata        Json?
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  members         Member[]
  projectMembers  ProjectMember[]
  projects        Project[]
  auditEvents     AuditEvent[]
  idempotencyKeys IdempotencyKey[]
  outboxEvents    OutboxEvent[]
  jobRuns         JobRun[]
  notifications   Notification[]
}

model Member {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  tenantRole     MembershipRole @default(ORG_VIEWER)
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  slug           String
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  serviceState   ProjectServiceState @default(ACTIVE)
  siteBaseUrl    String?
  publicUrlPolicyVersion String?
  notes          String?
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  notifications  Notification[]
  members        ProjectMember[]
  publicUrlIdReservations PublicUrlIdReservation[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([status, updatedAt])
}

model ProjectMember {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  userId         String
  role           ProjectMemberRole @default(PROJECT_VIEWER)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, projectId, userId])
  @@index([userId])
  @@index([organizationId, projectId])
}

model Notification {
  id             String                 @id @default(cuid())
  organizationId String?
  projectId      String?
  category       NotificationCategory
  severity       NotificationSeverity
  visibility     NotificationVisibility @default(PLATFORM_TEAM)
  title          String
  message        String
  route          String?
  sourceType     String
  sourceId       String?
  dedupKey       String                 @unique
  occurredAt     DateTime               @db.Timestamptz(3)
  createdAt      DateTime               @default(now())
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reads          NotificationRead[]

  @@index([visibility, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([projectId, occurredAt])
}

model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime     @db.Timestamptz(3)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
}

model AuditEvent {
  id             String         @id @default(cuid())
  organizationId String?
  actorType      AuditActorType
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  beforeMarker   Json?
  afterMarker    Json?
  source         String
  correlationId  String
  createdAt      DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([correlationId])
}

model IdempotencyKey {
  id                String            @id @default(cuid())
  organizationScope String
  organizationId    String?
  scope             String
  key               String
  requestHash       String
  status            IdempotencyStatus
  response          Json?
  errorCode         String?
  outboxEventId     String?           @unique
  expiresAt         DateTime          @db.Timestamptz(3)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  outboxEvent       OutboxEvent?      @relation(fields: [outboxEventId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([scope, organizationScope, key])
  @@index([status, expiresAt])
  @@index([organizationId, createdAt])
}

model OutboxEvent {
  id             String          @id @default(cuid())
  organizationId String?
  topic          String
  payload        Json
  schemaVersion  Int             @default(1)
  occurredAt     DateTime        @default(now())
  status         OutboxStatus    @default(PENDING)
  attempts       Int             @default(0)
  availableAt    DateTime        @default(now())
  lockedAt       DateTime?       @db.Timestamptz(3)
  lockedBy       String?
  lastErrorCode  String?
  correlationId  String
  processedAt    DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  idempotencyKey IdempotencyKey?
  jobRuns        JobRun[]

  @@index([status, availableAt])
  @@index([lockedAt])
  @@index([organizationId, topic, createdAt])
}

model JobRun {
  id             String        @id @default(cuid())
  organizationId String?
  outboxEventId  String
  jobType        String
  status         JobRunStatus
  attempt        Int
  workerId       String
  startedAt      DateTime      @db.Timestamptz(3)
  finishedAt     DateTime?     @db.Timestamptz(3)
  safeErrorCode  String?
  correlationId  String
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  outboxEvent    OutboxEvent   @relation(fields: [outboxEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([outboxEventId, attempt])
  @@index([status, startedAt])
  @@index([organizationId, jobType, startedAt])
}

model RuntimeHeartbeat {
  id          String   @id @default(cuid())
  runtime     String
  workerId    String
  startedAt   DateTime @db.Timestamptz(3)
  heartbeatAt DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([runtime, workerId])
  @@index([runtime, heartbeatAt])
}

model RetentionRun {
  id                  String             @id @default(cuid())
  status              RetentionRunStatus
  startedAt           DateTime           @db.Timestamptz(3)
  finishedAt          DateTime?          @db.Timestamptz(3)
  deletedOutboxEvents Int                @default(0)
  deletedJobRuns      Int                @default(0)
  safeErrorCode       String?
  createdAt           DateTime           @default(now())

  @@index([status, startedAt])
}

model PublicUrlIdReservation {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  subjectType    String   @db.VarChar(64)
  subjectUid     String   @db.VarChar(26)
  publicUrlId    String   @db.VarChar(16)
  reservedAt     DateTime @default(now()) @db.Timestamptz(3)
  project        Project  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, projectId, subjectType, subjectUid])
  @@unique([projectId, publicUrlId])
  @@index([organizationId, reservedAt])
  @@index([subjectUid])
}

model Region {
  uid            String                 @id @db.VarChar(26)
  code           String                 @unique @db.VarChar(12)
  name           String                 @db.VarChar(160)
  normalizedName String                 @unique @db.VarChar(160)
  lifecycle      CatalogLifecycleStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  aliases        RegionAlias[]
  cities         City[]

  @@index([lifecycle, normalizedName])
}

model RegionAlias {
  regionUid       String @db.VarChar(26)
  value           String @db.VarChar(160)
  normalizedValue String @db.VarChar(160)
  region          Region @relation(fields: [regionUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@id([regionUid, normalizedValue])
  @@index([normalizedValue])
}

model City {
  uid            String                 @id @db.VarChar(26)
  regionUid      String                 @db.VarChar(26)
  name           String                 @db.VarChar(160)
  normalizedName String                 @db.VarChar(160)
  lifecycle      CatalogLifecycleStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  region         Region                 @relation(fields: [regionUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  aliases        CityAlias[]
  districts      District[]
  developments   Development[]

  @@unique([regionUid, normalizedName])
  @@index([lifecycle, normalizedName])
}

model CityAlias {
  cityUid         String @db.VarChar(26)
  value           String @db.VarChar(160)
  normalizedValue String @db.VarChar(160)
  city            City   @relation(fields: [cityUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@id([cityUid, normalizedValue])
  @@index([normalizedValue])
}

model District {
  uid            String                 @id @db.VarChar(26)
  cityUid        String                 @db.VarChar(26)
  name           String                 @db.VarChar(160)
  normalizedName String                 @db.VarChar(160)
  lifecycle      CatalogLifecycleStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  city           City                   @relation(fields: [cityUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  aliases        DistrictAlias[]
  developments   Development[]

  @@unique([cityUid, normalizedName])
  @@unique([cityUid, uid])
  @@index([lifecycle, normalizedName])
}

model DistrictAlias {
  districtUid     String   @db.VarChar(26)
  value           String   @db.VarChar(160)
  normalizedValue String   @db.VarChar(160)
  district        District @relation(fields: [districtUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@id([districtUid, normalizedValue])
  @@index([normalizedValue])
}

model Developer {
  uid            String                 @id @db.VarChar(26)
  name           String                 @db.VarChar(200)
  normalizedName String                 @unique @db.VarChar(200)
  lifecycle      CatalogLifecycleStatus @default(ACTIVE)
  version        Int                    @default(1)
  mergedIntoUid  String?                @db.VarChar(26)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  mergedInto     Developer?             @relation("DeveloperMerge", fields: [mergedIntoUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  mergedFrom     Developer[]            @relation("DeveloperMerge")
  aliases        DeveloperAlias[]
  developments   Development[]

  @@index([lifecycle, normalizedName])
  @@index([mergedIntoUid])
}

model DeveloperAlias {
  developerUid    String    @db.VarChar(26)
  value           String    @db.VarChar(200)
  normalizedValue String    @db.VarChar(200)
  developer       Developer @relation(fields: [developerUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@id([developerUid, normalizedValue])
  @@index([normalizedValue])
}

model Development {
  uid            String                 @id @db.VarChar(26)
  developerUid   String                 @db.VarChar(26)
  cityUid        String                 @db.VarChar(26)
  districtUid    String?                @db.VarChar(26)
  name           String                 @db.VarChar(200)
  normalizedName String                 @db.VarChar(200)
  lifecycle      CatalogLifecycleStatus @default(ACTIVE)
  version        Int                    @default(1)
  mergedIntoUid  String?                @db.VarChar(26)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  developer      Developer              @relation(fields: [developerUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  city           City                   @relation(fields: [cityUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  district       District?              @relation(fields: [cityUid, districtUid], references: [cityUid, uid], onDelete: Restrict, onUpdate: Cascade)
  mergedInto     Development?           @relation("DevelopmentMerge", fields: [mergedIntoUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  mergedFrom     Development[]          @relation("DevelopmentMerge")
  aliases        DevelopmentAlias[]
  buildings      Building[]

  @@unique([cityUid, normalizedName])
  @@index([developerUid, lifecycle])
  @@index([districtUid])
  @@index([mergedIntoUid])
}

model DevelopmentAlias {
  developmentUid String      @db.VarChar(26)
  value           String      @db.VarChar(200)
  normalizedValue String      @db.VarChar(200)
  development     Development @relation(fields: [developmentUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@id([developmentUid, normalizedValue])
  @@index([normalizedValue])
}

model Building {
  uid                  String                 @id @db.VarChar(26)
  developmentUid       String                 @db.VarChar(26)
  label                String                 @db.VarChar(160)
  normalizedLabel      String                 @db.VarChar(160)
  floors               Int?
  commissioningYear    Int?
  commissioningQuarter Int?
  constructionStatus   ConstructionStatus     @default(PLANNED)
  material             String?                @db.VarChar(120)
  housingClass         String?                @db.VarChar(80)
  lifecycle            CatalogLifecycleStatus @default(ACTIVE)
  version              Int                    @default(1)
  mergedIntoUid        String?                @db.VarChar(26)
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(3)
  development          Development            @relation(fields: [developmentUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  mergedInto           Building?              @relation("BuildingMerge", fields: [mergedIntoUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  mergedFrom           Building[]             @relation("BuildingMerge")
  aliases              BuildingAlias[]

  @@unique([developmentUid, normalizedLabel])
  @@index([constructionStatus, lifecycle])
  @@index([mergedIntoUid])
}

model BuildingAlias {
  buildingUid     String   @db.VarChar(26)
  value           String   @db.VarChar(160)
  normalizedValue String   @db.VarChar(160)
  building        Building @relation(fields: [buildingUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@id([buildingUid, normalizedValue])
  @@index([normalizedValue])
}
