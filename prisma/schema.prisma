  lifecycle      CatalogLifecycleStatus @default(ACTIVE)
  version        Int                    @default(1)
  mergedIntoUid  String?                @db.VarChar(26)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  mergedInto     Developer?             @relation("DeveloperMerge", fields: [mergedIntoUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  mergedFrom     Developer[]            @relation("DeveloperMerge")
  aliases        DeveloperAlias[]
  developments   Development[]

  @@index([lifecycle, normalizedName])
  @@index([mergedIntoUid])
}

model DeveloperAlias {
  developerUid    String    @db.VarChar(26)
  value           String    @db.VarChar(200)
  normalizedValue String    @db.VarChar(200)
  developer       Developer @relation(fields: [developerUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@id([developerUid, normalizedValue])
  @@index([normalizedValue])
}

model Development {
  uid                String                                @id @db.VarChar(26)
  developerUid       String                                @db.VarChar(26)
  cityUid            String                                @db.VarChar(26)
  districtUid        String?                               @db.VarChar(26)
  name               String                                @db.VarChar(200)
  normalizedName     String                                @db.VarChar(200)
  addressLine        String?                               @db.VarChar(500)
  latitude           Decimal?                              @db.Decimal(10, 7)
  longitude          Decimal?                              @db.Decimal(10, 7)
  lifecycle          CatalogLifecycleStatus                @default(ACTIVE)
  version            Int                                   @default(1)
  mergedIntoUid      String?                               @db.VarChar(26)
  createdAt          DateTime                              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                              @updatedAt @db.Timestamptz(3)
  developer          Developer                             @relation(fields: [developerUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  city               City                                  @relation(fields: [cityUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  district           District?                             @relation(fields: [cityUid, districtUid], references: [cityUid, uid], onDelete: Restrict, onUpdate: Cascade)
  mergedInto         Development?                          @relation("DevelopmentMerge", fields: [mergedIntoUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  mergedFrom         Development[]                         @relation("DevelopmentMerge")
  aliases            DevelopmentAlias[]
  buildings          Building[]
  catalogSelections  ProjectCatalogSubscriptionSelection[]
  listingLinks       ListingDevelopmentLink[]
  externalIdentities DevelopmentExternalIdentity[]
  priceObservations  PriceObservation[]
  sharedMediaAssets  SharedMediaAsset[]

  @@unique([cityUid, normalizedName])
  @@index([developerUid, lifecycle])
  @@index([districtUid])
  @@index([mergedIntoUid])
}

model ListingDevelopmentLink {
  id                  String                       @id @default(cuid())
  organizationId      String
  projectId           String
  inventoryUid        String                       @db.VarChar(26)
  developmentUid      String?                      @db.VarChar(26)
  candidateReason     String                       @db.VarChar(500)
  candidateConfidence Decimal?                     @db.Decimal(5, 4)
  status              ListingDevelopmentLinkStatus @default(CANDIDATE)
  confirmedBy         String?
  confirmedAt         DateTime?                    @db.Timestamptz(3)
  sourceRevisionId    String?                      @db.VarChar(128)
  version             Int                          @default(1)
  createdAt           DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                     @updatedAt @db.Timestamptz(3)
  project             Project                      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)
  development         Development?                 @relation(fields: [developmentUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, projectId, inventoryUid])
  @@index([projectId, status])
  @@index([developmentUid])
}

model DevelopmentAlias {
  developmentUid  String      @db.VarChar(26)
  value           String      @db.VarChar(200)
  normalizedValue String      @db.VarChar(200)
  development     Development @relation(fields: [developmentUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@id([developmentUid, normalizedValue])
  @@index([normalizedValue])
}

model Building {
  uid                  String                 @id @db.VarChar(26)
  developmentUid       String                 @db.VarChar(26)
  label                String                 @db.VarChar(160)
  normalizedLabel      String                 @db.VarChar(160)
  floors               Int?
  commissioningYear    Int?
  commissioningQuarter Int?
  constructionStatus   ConstructionStatus     @default(PLANNED)
  material             String?                @db.VarChar(120)
  housingClass         String?                @db.VarChar(80)
  lifecycle            CatalogLifecycleStatus @default(ACTIVE)
  version              Int                    @default(1)
  mergedIntoUid        String?                @db.VarChar(26)
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(3)
  development          Development            @relation(fields: [developmentUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  mergedInto           Building?              @relation("BuildingMerge", fields: [mergedIntoUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  mergedFrom           Building[]             @relation("BuildingMerge")
  aliases              BuildingAlias[]
  priceObservations    PriceObservation[]
  sharedMediaAssets    SharedMediaAsset[]

  @@unique([developmentUid, normalizedLabel])
  @@unique([developmentUid, uid])
  @@index([constructionStatus, lifecycle])
  @@index([mergedIntoUid])
}

model DevelopmentExternalIdentity {
  id              String      @id @default(cuid())
  organizationId  String
  projectId       String
  sourceId        String
  developmentUid  String      @db.VarChar(26)
  externalId      String      @db.VarChar(240)
  firstObservedAt DateTime    @db.Timestamptz(3)
  lastObservedAt  DateTime    @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  project         Project     @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)
  source          Source      @relation(fields: [organizationId, projectId, sourceId], references: [organizationId, projectId, id], onDelete: Cascade, onUpdate: Cascade)
  development     Development @relation(fields: [developmentUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, projectId, sourceId, externalId])
  @@index([developmentUid, lastObservedAt])
}

model PriceObservation {
  id             String                @id @default(cuid())
  organizationId String
  projectId      String
  sourceId       String
  developmentUid String                @db.VarChar(26)
  buildingUid    String?               @db.VarChar(26)
  externalId     String                @db.VarChar(240)
  observedAt     DateTime              @db.Timestamptz(3)
  amount         Decimal               @db.Decimal(18, 2)
  currency       String                @db.Char(3)
  basis          PriceObservationBasis @default(TOTAL)
  areaM2         Decimal?              @db.Decimal(12, 2)
  roomCount      Int?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  project        Project               @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)
  source         Source                @relation(fields: [organizationId, projectId, sourceId], references: [organizationId, projectId, id], onDelete: Cascade, onUpdate: Cascade)
  development    Development           @relation(fields: [developmentUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  building       Building?             @relation(fields: [developmentUid, buildingUid], references: [developmentUid, uid], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, projectId, sourceId, externalId, observedAt, basis])
  @@index([developmentUid, observedAt])
  @@index([buildingUid, observedAt])
}

model SharedMediaAsset {
  id                 String           @id @default(cuid())
  organizationId     String
  projectId          String
  sourceId           String
  developmentUid     String           @db.VarChar(26)
  buildingUid        String?          @db.VarChar(26)
  externalId         String           @db.VarChar(240)
  kind               MediaSourceKind  @default(DEVELOPMENT_IMAGE)
  position           Int
  sourceUrl          String           @db.VarChar(2048)
  canonicalSourceUrl String           @db.VarChar(2048)
  rightsBasis        MediaRightsBasis
  attribution        String?          @db.VarChar(500)
  license            String?          @db.VarChar(255)
  observedAt         DateTime         @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  project            Project          @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)
  source             Source           @relation(fields: [organizationId, projectId, sourceId], references: [organizationId, projectId, id], onDelete: Cascade, onUpdate: Cascade)
  development        Development      @relation(fields: [developmentUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)
  building           Building?        @relation(fields: [developmentUid, buildingUid], references: [developmentUid, uid], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, projectId, sourceId, developmentUid, canonicalSourceUrl])
  @@index([developmentUid, position])
  @@index([buildingUid, position])
}

model BuildingAlias {
  buildingUid     String   @db.VarChar(26)
  value           String   @db.VarChar(160)
  normalizedValue String   @db.VarChar(160)
  building        Building @relation(fields: [buildingUid], references: [uid], onDelete: Restrict, onUpdate: Cascade)

  @@id([buildingUid, normalizedValue])
  @@index([normalizedValue])
}

model CatalogChangeSet {
  id             String                  @id @default(cuid())
  actorId        String                  @db.VarChar(191)
  action         String                  @db.VarChar(120)
  source         CatalogProvenanceSource @default(MANUAL_ADMIN)
  correlationId  String                  @db.VarChar(191)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  entityVersions CatalogEntityVersion[]

  @@index([createdAt])
  @@index([correlationId])
}

model CatalogEntityVersion {
  id          String            @id @default(cuid())
  changeSetId String
  entityType  CatalogEntityType
  entityUid   String            @db.VarChar(26)
  version     Int
  changeKind  CatalogChangeKind
  snapshot    Json
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  changeSet   CatalogChangeSet  @relation(fields: [changeSetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  provenance  FactProvenance[]

  @@unique([entityType, entityUid, version])
  @@unique([id, changeSetId, entityType, entityUid])
  @@index([changeSetId])
  @@index([entityType, entityUid, createdAt])
}

model FactProvenance {
  id              String                  @id @default(cuid())
  changeSetId     String
  entityVersionId String
  entityType      CatalogEntityType
  entityUid       String                  @db.VarChar(26)
  fieldPath       String                  @db.VarChar(160)
  valueSnapshot   Json
  source          CatalogProvenanceSource @default(MANUAL_ADMIN)
  actorId         String                  @db.VarChar(191)
  recordedAt      DateTime                @default(now()) @db.Timestamptz(3)
  entityVersion   CatalogEntityVersion    @relation(fields: [entityVersionId, changeSetId, entityType, entityUid], references: [id, changeSetId, entityType, entityUid], onDelete: Restrict, onUpdate: Cascade)

  @@unique([entityVersionId, fieldPath])
  @@index([changeSetId])
  @@index([entityType, entityUid, fieldPath, recordedAt])
}
