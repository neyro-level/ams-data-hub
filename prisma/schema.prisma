generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  PLATFORM_ADMIN
  USER
}

enum MembershipRole {
  ORG_ADMIN
  ORG_EDITOR
  ORG_VIEWER
}

enum ProjectMemberRole {
  PROJECT_EDITOR
  PROJECT_VIEWER
}

enum AuditActorType {
  USER
  SYSTEM
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER
}

enum JobRunStatus {
  RUNNING
  SUCCESS
  FAILED
  DEFERRED
}

enum RetentionRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum DeliveryRunStatus {
  PENDING
  NOTIFIED
  DOWNLOADED
  APPLIED
  ACKNOWLEDGED
  FAILED
  STALE
}

enum InventoryLifecycleStatus {
  ACTIVE
  INACTIVE
}

enum InventoryLifecycleEventType {
  INACTIVATED
  REACTIVATED
}

enum ProjectStatus {
  ACTIVE
  PLANNED
  DISABLED
}

enum MediaRightsBasis {
  OWNED
  LICENSED
  PUBLIC_DOMAIN
}

enum MediaSourceKind {
  LISTING_IMAGE
  AGENT_PHOTO
  DEVELOPMENT_IMAGE
  OTHER
}

enum MediaMirrorStatus {
  MIRRORED
  WARNING
}

enum PriceObservationBasis {
  TOTAL
  PER_SQUARE_METER
}

enum NotificationCategory {
  SYSTEM
  PROJECT
  ACCESS
  QUEUE
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationVisibility {
  PLATFORM_TEAM
  PLATFORM_ADMIN_ONLY
}

enum CatalogLifecycleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ConstructionStatus {
  PLANNED
  UNDER_CONSTRUCTION
  COMPLETED
  SUSPENDED
}

enum CatalogSubscriptionMode {
  ALL_SHARED
  CURATED
}

enum CatalogSelectionDecision {
  INCLUDE
  EXCLUDE
}

enum CatalogEntityType {
  DEVELOPER
  DEVELOPMENT
  BUILDING
}

enum CatalogChangeKind {
  CREATE
  UPDATE
  RELINK
  MERGE
  MERGE_REASSIGN
}

enum CatalogProvenanceSource {
  MANUAL_ADMIN
}

enum ProjectEditorialEntityType {
  DEVELOPER
  DEVELOPMENT
  BUILDING
  INVENTORY
  AGENT
}

enum ListingDevelopmentLinkStatus {
  CANDIDATE
  CONFIRMED
  REJECTED
}

enum FactualLifecycleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DEPARTED
}

enum PresentationLifecycleStatus {
  VISIBLE
  ARCHIVED_VISIBLE
  REDIRECTED
  GONE
}

enum ProjectRedirectReason {
  SLUG_CHANGE
  RELINK
  RETIRE
  LIFECYCLE
  MANUAL
}

enum SourceDatasetType {
  MIXED_REALTY
  RESALE
  NEW_BUILD
  HOUSE
  LAND
  COMMERCIAL
  AGENT
}

enum SourceTransportType {
  HTTPS_XML
}

enum SourceSharingPolicy {
  PROJECT_ONLY
}

enum SourceManualRunStatus {
  REQUESTED
  CLAIMED
  COMPLETED
  FAILED
}

enum AgentRole {
  AGENT
  LAWYER
  MORTGAGE_BROKER
  MANAGER
  OTHER
}

enum AgentOrigin {
  FEED
  MANUAL
}

enum AgentStatus {
  ACTIVE
  HIDDEN
  DEPARTED
}

enum AgentListingPresenceStatus {
  HAS_ACTIVE_LISTINGS
  NO_ACTIVE_LISTINGS
  UNKNOWN
}

enum AgentMatchReviewStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum AgentMergeEventType {
  MERGE
  RELINK
  SPLIT
}

model User {
  id                String                  @id
  name              String
  username          String?                 @unique
  email             String                  @unique
  emailVerified     Boolean                 @default(false)
  image             String?
  failedLoginCount  Int                     @default(0)
  loginLockedUntil  DateTime?               @db.Timestamptz(3)
  setupCompletedAt  DateTime?
  systemRole        SystemRole              @default(USER)
  disabledAt        DateTime?               @db.Timestamptz(3)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  sessions          Session[]
  accounts          Account[]
  members           Member[]
  projectMembers    ProjectMember[]
  notificationReads NotificationRead[]
  setupTokens       AccountSetupToken[]
  recoveryTokens    PlatformRecoveryToken[]

  @@index([loginLockedUntil])
}

enum ProjectServiceState {
  ACTIVE
  SUSPENDED
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model AccountSetupToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
}

model PlatformRecoveryToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id                   String    @id
  userId               String
  token                String    @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeTeamId         String?
  activeOrganizationId String?
  setupCompletedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
}

model Account {
  id                    String    @id
  userId                String
  issuer                String?
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  logo            String?
  metadata        Json?
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  members         Member[]
  projectMembers  ProjectMember[]
  projects        Project[]
  auditEvents     AuditEvent[]
  idempotencyKeys IdempotencyKey[]
  outboxEvents    OutboxEvent[]
  jobRuns         JobRun[]
  notifications   Notification[]
  mediaAssets     MediaAsset[]
}

model Member {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  tenantRole     MembershipRole @default(ORG_VIEWER)
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Project {
  id                       String                          @id @default(cuid())
  organizationId           String
  slug                     String
  name                     String
  description              String?
  status                   ProjectStatus                   @default(ACTIVE)
  serviceState             ProjectServiceState             @default(ACTIVE)
  siteBaseUrl              String?
  publicUrlPolicyVersion   String?
  notes                    String?
  version                  Int                             @default(1)
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  organization             Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  notifications            Notification[]
  members                  ProjectMember[]
  mediaAssets              MediaAsset[]
  mediaSources             MediaSource[]
  developmentIdentities    DevelopmentExternalIdentity[]
  priceObservations        PriceObservation[]
  sharedMediaAssets        SharedMediaAsset[]
  publicUrlIdReservations  PublicUrlIdReservation[]
  catalogSubscription      ProjectCatalogSubscription?
  publicContact            ProjectPublicContact?
  entityEditorial          EntityEditorial[]
  entityMediaOrderPolicy   EntityMediaOrderPolicy[]
  urlPolicy                ProjectUrlPolicy?
  urlEntries               ProjectUrlEntry[]
  redirects                ProjectRedirect[]
  urlTombstones            ProjectUrlTombstone[]
  sources                  Source[]
  sourceCredentialRefs     SourceCredentialRef[]
  sourceManualRunRequests  SourceManualRunRequest[]
  sourceRevisions          SourceRevision[]
  sourceRevisionRecords    SourceRevisionRecord[]
  sourceSafetyPolicies     SourceSafetyPolicy[]
  agents                   Agent[]
  agentExternalIdentities  AgentExternalIdentity[]
  agentSourceEvidence      AgentSourceEvidence[]
  agentMatchReviews        AgentMatchReview[]
  agentMergeEvents         AgentMergeEvent[]
  agentConsentBatches      AgentConsentBatch[]
  currentSnapshotManifest  ProjectCurrentSnapshotManifest?
  deliveryRuns             DeliveryRun[]
  ackCredential            ProjectAckCredential?
  inventoryIdentities      InventoryIdentity[]
  inventoryLifecycleEvents InventoryLifecycleEvent[]
  listingDevelopmentLinks  ListingDevelopmentLink[]
  snapshotBuildInputs      SnapshotBuildInput[]
  snapshotSequence         ProjectSnapshotSequence?

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([status, updatedAt])
}

model ProjectSnapshotSequence {
  organizationId       String
  projectId            String
  lastReservedSequence Int
  project              Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([organizationId, projectId])
}

model SnapshotBuildInput {
  id                   String @id @default(cuid())
  organizationId       String
  projectId            String
  idempotencyKeyHash   String @db.Char(64)
  requestHash          String @db.Char(64)
  inputSchemaVersion   Int
  projectorVersion     String @db.VarChar(64)
  schemaMinor          Int
  publishSequence      Int
  projectStateRevision Int
  catalogRevision      String @db.Char(64)
  inputHash            String @db.Char(64)
  capturedAt           DateTime @db.Timestamptz(3)
  captureTransactionId BigInt @default(dbgenerated("txid_current()"))
  project              Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  parts                SnapshotBuildInputPart[]
  publicationBinding   SnapshotPublicationBinding?

  @@unique([organizationId, projectId, id])
  @@unique([organizationId, projectId, idempotencyKeyHash])
  @@unique([organizationId, projectId, publishSequence])
}

model SnapshotBuildInputPart {
  organizationId String
  projectId      String
  buildInputId   String
  kind           String @db.VarChar(64)
  partIndex      Int
  payloadHash    String @db.Char(64)
  payload        Json
  payloadByteCount Int @default(dbgenerated())
  payloadRecordCount Int @default(dbgenerated())
  buildInput     SnapshotBuildInput @relation(fields: [organizationId, projectId, buildInputId], references: [organizationId, projectId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([buildInputId, kind, partIndex])
}

model SnapshotPublicationBinding {
  organizationId    String
  projectId         String
  buildInputId      String
  inputHash         String @db.Char(64)
  publishSequence   Int
  keyId             String @db.VarChar(240)
  manifestSha256    String @db.Char(64)
  manifestCanonical String @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  buildInput        SnapshotBuildInput @relation(fields: [organizationId, projectId, buildInputId], references: [organizationId, projectId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([organizationId, projectId, buildInputId])
  @@unique([organizationId, projectId, publishSequence])
}

model ProjectCurrentSnapshotManifest {
  organizationId  String
  projectId       String
  publishSequence Int
  manifestKey     String   @db.VarChar(512)
  manifestSha256  String   @db.VarChar(64)
  publishedAt     DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  project         Project  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([organizationId, projectId])
  @@index([projectId, publishSequence])
}

model DeliveryRun {
  id                    String            @id @default(cuid())
  organizationId        String
  projectId             String
  publishSequence       Int
  manifestKey           String            @db.VarChar(512)
  manifestSha256        String            @db.VarChar(64)
  status                DeliveryRunStatus @default(PENDING)
  publishedAt           DateTime          @db.Timestamptz(3)
  notifiedAt            DateTime?         @db.Timestamptz(3)
  downloadedAt          DateTime?         @db.Timestamptz(3)
  appliedAt             DateTime?         @db.Timestamptz(3)
  acknowledgedAt        DateTime?         @db.Timestamptz(3)
  failedAt              DateTime?         @db.Timestamptz(3)
  staleAt               DateTime?         @db.Timestamptz(3)
  safeErrorCode         String?           @db.VarChar(120)
  ackIdempotencyKeyHash String?           @db.VarChar(64)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  project               Project           @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, projectId, publishSequence])
  @@index([status, createdAt])
  @@index([projectId, publishSequence])
}

model ProjectAckCredential {
  organizationId   String
  projectId        String
  currentTokenHash String    @db.VarChar(255)
  nextTokenHash    String?   @db.VarChar(255)
  version          Int       @default(1)
  rotatedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  project          Project   @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([organizationId, projectId])
  @@index([projectId])
}

model ProjectMember {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  userId         String
  role           ProjectMemberRole @default(PROJECT_VIEWER)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project        Project           @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, projectId, userId])
  @@index([userId])
  @@index([organizationId, projectId])
}

model Agent {
  id                    String                     @id @default(cuid())
  uid                   String                     @unique @db.VarChar(26)
  organizationId        String
  projectId             String
  slug                  String                     @db.VarChar(200)
  role                  AgentRole                  @default(AGENT)
  origin                AgentOrigin                @default(MANUAL)
  fullName              String                     @db.VarChar(240)
  position              String?                    @db.VarChar(240)
  bio                   String?                    @db.VarChar(4000)
  specializations       String[]                   @default([])
  photoMediaId          String?
  feedPhotoMediaId      String?
  workPhone             String?                    @db.VarChar(40)
  workEmail             String?                    @db.VarChar(320)
  messengers            Json                       @default("[]")
  showOnSite            Boolean                    @default(false)
  sortOrder             Int                        @default(0)
  status                AgentStatus                @default(ACTIVE)
  listingPresenceStatus AgentListingPresenceStatus @default(UNKNOWN)
  consentConfirmedBy    String?
  consentConfirmedAt    DateTime?                  @db.Timestamptz(3)
  consentBasis          String?                    @db.VarChar(1000)
  consentBatchId        String?
  version               Int                        @default(1)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @db.Timestamptz(3)
  project               Project                    @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)
  externalIdentities    AgentExternalIdentity[]
  listingBindings       ListingAgentBinding[]
  sourceEvidence        AgentSourceEvidence[]
  consentBatch          AgentConsentBatch?         @relation(fields: [organizationId, projectId, consentBatchId], references: [organizationId, projectId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, projectId, uid])
  @@unique([projectId, slug])
  @@index([projectId, status, sortOrder])
  @@index([projectId, listingPresenceStatus])
  @@index([organizationId, projectId, consentBatchId])
}

model AgentConsentBatch {
  id             String   @id @db.VarChar(26)
  organizationId String
  projectId      String
  confirmedBy    String   @db.VarChar(240)
  confirmedAt    DateTime @db.Timestamptz(3)
  basis          String?  @db.VarChar(1000)
  referenceUrl   String?  @db.VarChar(2048)
  note           String?  @db.VarChar(2000)
  actorId        String
  correlationId  String
  agentCount     Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  project        Project  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)
  agents         Agent[]

  @@unique([organizationId, projectId, id])
  @@index([projectId, createdAt])
}

model AgentExternalIdentity {
  id                String   @id @default(cuid())
  organizationId    String
  projectId         String
  agentUid          String   @db.VarChar(26)
  sourceId          String   @db.VarChar(128)
  externalId        String?  @db.VarChar(255)
  phoneNorm         String?  @db.VarChar(40)
  emailNorm         String?  @db.VarChar(320)
  sharedOfficePhone Boolean  @default(false)
  firstSeenAt       DateTime @db.Timestamptz(3)
  lastSeenAt        DateTime @db.Timestamptz(3)
  version           Int      @default(1)
  agent             Agent    @relation(fields: [organizationId, projectId, agentUid], references: [organizationId, projectId, uid], onDelete: Restrict, onUpdate: Cascade)
  project           Project  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, sourceId, externalId])
  @@index([projectId, phoneNorm])
  @@index([projectId, emailNorm])
  @@index([agentUid])
}

model AgentSourceEvidence {
  id                 String   @id @default(cuid())
  organizationId     String
  projectId          String
  sourceId           String
  agentUid           String?  @db.VarChar(26)
  evidenceKey        String   @db.Char(64)
  fullNameRaw        String?  @db.VarChar(240)
  normalizedFullName String?  @db.VarChar(240)
  phoneRaw           String?  @db.VarChar(80)
  phoneNorm          String?  @db.VarChar(40)
  photoSourceUrl     String?  @db.VarChar(2048)
  categoryRaw        String?  @db.VarChar(120)
  firstSeenAt        DateTime @db.Timestamptz(3)
  lastSeenAt         DateTime @db.Timestamptz(3)
  sourceRevisionId   String   @db.VarChar(128)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  project            Project  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)
  source             Source   @relation(fields: [organizationId, projectId, sourceId], references: [organizationId, projectId, id], onDelete: Cascade, onUpdate: Cascade)
  agent              Agent?   @relation(fields: [organizationId, projectId, agentUid], references: [organizationId, projectId, uid], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, projectId, sourceId, evidenceKey])
  @@index([projectId, phoneNorm])
  @@index([agentUid, lastSeenAt])
  @@index([sourceId, sourceRevisionId])
}

model AgentMatchReview {
  id                 String                 @id @default(cuid())
  organizationId     String
  projectId          String
  sourceId           String                 @db.VarChar(128)
  candidateAgentUid  String?                @db.VarChar(26)
  proposedAgentUid   String?                @db.VarChar(26)
  normalizedFullName String                 @db.VarChar(240)
  phoneNorm          String?                @db.VarChar(40)
  emailNorm          String?                @db.VarChar(320)
  reason             String                 @db.VarChar(500)
  status             AgentMatchReviewStatus @default(PENDING)
  resolvedBy         String?
  resolvedAt         DateTime?              @db.Timestamptz(3)
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  project            Project                @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId, status, createdAt])
  @@index([candidateAgentUid])
}

model AgentMergeEvent {
  id                 String              @id @default(cuid())
  organizationId     String
  projectId          String
  type               AgentMergeEventType
  sourceAgentUid     String              @db.VarChar(26)
  targetAgentUid     String              @db.VarChar(26)
  externalIdentityId String?
  actorId            String
  correlationId      String
  detail             Json
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  project            Project             @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId, createdAt])
  @@index([sourceAgentUid])
  @@index([targetAgentUid])
}

model ProjectPublicContact {
  organizationId String
  projectId      String
  phone          String   @db.VarChar(40)
  email          String?  @db.VarChar(320)
  addressPublic  String?  @db.VarChar(500)
  messengers     Json
  hours          String?  @db.VarChar(500)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  project        Project  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([organizationId, projectId])
  @@index([projectId])
}

model EntityEditorial {
  organizationId          String
  projectId               String
  entityType              ProjectEditorialEntityType
  entityUid               String                     @db.VarChar(26)
  shortDescription        String?                    @db.VarChar(500)
  description             String?                    @db.VarChar(4000)
  faq                     Json
  presentationNotes       String?                    @db.VarChar(2000)
  mediaOrder              String[]                   @default([])
  mediaOrderPolicyVersion Int?
  version                 Int                        @default(1)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                   @updatedAt @db.Timestamptz(3)
  project                 Project                    @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([organizationId, projectId, entityType, entityUid])
  @@index([projectId, entityType])
}

model EntityMediaOrderPolicy {
  organizationId            String
  projectId                 String
  entityType                ProjectEditorialEntityType
  entityUid                 String                     @db.VarChar(26)
  sourceMediaOrder          String[]                   @default([])
  isImageOrderChangeAllowed Boolean                    @default(false)
  version                   Int                        @default(1)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  project                   Project                    @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([organizationId, projectId, entityType, entityUid])
  @@index([projectId, entityType])
}

model ProjectUrlPolicy {
  organizationId     String
  projectId          String
  policyKey          String   @db.VarChar(128)
  pathTemplates      Json
  reservedNamespaces String[] @default([])
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  project            Project  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([organizationId, projectId])
  @@index([projectId])
}

model ProjectUrlEntry {
  id                    String                      @id @default(cuid())
  organizationId        String
  projectId             String
  entityType            ProjectEditorialEntityType
  entityUid             String                      @db.VarChar(26)
