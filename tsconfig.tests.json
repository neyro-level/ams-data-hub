{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "incremental": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.mts",
    "vitest.integration.config.mts"
  ],
  "exclude": ["node_modules", ".next", "dist-collector"]
}
