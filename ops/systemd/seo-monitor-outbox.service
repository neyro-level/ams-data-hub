[Unit]
Description=AMS SEO Monitor outbox retention
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ams-platform/ams-seo-monitor/current
Environment=COMPOSE_PROJECT_NAME=ams-seo-monitor
EnvironmentFile=-/opt/ams-platform/ams-seo-monitor/shared/release.env
ExecStart=/usr/bin/docker compose -f /opt/ams-platform/ams-seo-monitor/current/docker-compose.production.yml run --rm --no-deps maintenance outbox-retention
TimeoutStartSec=20min
