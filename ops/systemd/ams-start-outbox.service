[Unit]
Description=AMS Start outbox retention
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ams-platform/ams-start/current
Environment=COMPOSE_PROJECT_NAME=ams-start
EnvironmentFile=-/opt/ams-platform/ams-start/shared/release.env
ExecStart=/usr/bin/docker compose -f /opt/ams-platform/ams-start/current/docker-compose.production.yml run --rm --no-deps maintenance outbox-retention
TimeoutStartSec=20min
