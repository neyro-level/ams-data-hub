{
  "name": "ams-data-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.5.1 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:status": "node --env-file=.env.local scripts/local-dev.mjs status",
    "dev:start": "node --env-file=.env.local scripts/local-dev.mjs start",
    "start": "node .next/standalone/server.js",
    "build": "pnpm prisma:generate && pnpm verify:config && next build && node scripts/prepare-standalone.mjs",
    "release:build": "node scripts/verify-release-runtime.mjs && pnpm build && pnpm worker:build && node scripts/build-release.mjs",
    "release:deploy": "node scripts/deploy-production.mjs",
    "lint": "eslint src packages tests scripts eslint.config.mjs next.config.ts playwright.config.ts vitest.config.mts vitest.integration.config.mts postcss.config.mjs",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "architecture:check": "depcruise src packages --config dependency-cruiser.config.cjs --output-type err-long && node scripts/verify-architecture.mjs",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:s3-isolation": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-timeweb-s3-isolation.ts",
    "test:data-safety-drill": "node --env-file=.env.local scripts/run-data-safety-drill.mjs",
    "test:safe-outbound": "vitest run tests/safe-outbound.test.ts",
    "test:secret-redaction": "vitest run tests/secret-redaction.test.ts",
    "test:data-contracts": "vitest run tests/data-contracts.test.ts tests/identity-schema-contract.test.ts",
    "test:runtime-infrastructure": "vitest run tests/runtime-infrastructure.test.ts tests/permanent-worker-guard.test.ts tests/db-bootstrap-roles.test.ts",
    "test:shared-catalog-schema": "vitest run tests/shared-catalog-schema.test.ts",
    "test:vladis-fixtures": "vitest run tests/vladis-vt24-fixtures.test.ts",
    "calibrate:vladis-feed": "vitest run scripts/calibrate-vladis-feed.test.ts",
    "audit:marketplace-feeds": "node --conditions=react-server --import tsx scripts/audit-marketplace-feeds.ts",
    "verify:rls-coverage": "node scripts/verify-rls-coverage.mjs",
    "test:security": "vitest run tests/principal.test.ts tests/data-hub-contracts.test.ts",
    "test:e2e": "pnpm build && node scripts/run-e2e-tests.mjs",
    "test:e2e:run": "node scripts/run-e2e-tests.mjs",
    "playwright:install": "playwright install chromium",
    "verify:quick": "pnpm verify:sourcecraft-policy && pnpm verify:no-template-traces && pnpm verify:config && pnpm verify:identity-contracts && pnpm verify:runtime-contract && pnpm verify:shared-catalog-schema && pnpm typecheck && pnpm lint && pnpm architecture:check",
    "verify:risky": "pnpm verify:quick && pnpm test:unit && pnpm test:security && pnpm build",
    "verify:daily": "pnpm verify:quick && pnpm test:unit && pnpm test:integration && pnpm build && pnpm test:e2e:run && pnpm security:semgrep && pnpm security:dependencies",
    "verify:release": "pnpm verify:daily && pnpm verify:conformance && node scripts/verify-release-runtime.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:bootstrap": "tsx scripts/seed-bootstrap.ts",
    "pgboss:migrate": "node --env-file-if-exists=.env.local scripts/pgboss-migrate.mjs",
    "dev:db:start": "node --env-file=.env.local scripts/local-postgres.mjs start",
    "dev:db:stop": "node --env-file=.env.local scripts/local-postgres.mjs stop",
    "dev:db:status": "node --env-file=.env.local scripts/local-postgres.mjs status",
    "dev:db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy && node --env-file=.env.local scripts/pgboss-migrate.mjs",
    "dev:db:bootstrap": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/seed-bootstrap.ts",
    "user:create": "tsx scripts/auth-admin.ts create",
    "admin:provision": "tsx scripts/auth-admin.ts provision",
    "user:reset-password": "tsx scripts/auth-admin.ts reset-password",
    "user:disable": "tsx scripts/auth-admin.ts disable",
    "user:set-system-role": "tsx scripts/auth-admin.ts set-system-role",
    "user:add-to-organization": "tsx scripts/auth-admin.ts add-to-organization",
    "user:remove-from-organization": "tsx scripts/auth-admin.ts remove-from-organization",
    "verify:config": "pnpm verify:public-data && pnpm verify:ui && node scripts/verify-config.mjs",
    "docs:check": "node scripts/verify-docs-canon.mjs",
    "verify:ui": "node scripts/verify-ui-conformance.mjs",
    "verify:public-data": "node scripts/verify-public-data.mjs",
    "verify:sourcecraft-policy": "node scripts/ci/verify-sourcecraft-policy.mjs",
    "verify:no-template-traces": "node scripts/verify-no-template-traces.mjs",
    "verify:identity-contracts": "node scripts/verify-identity-contracts.mjs",
    "verify:runtime-contract": "node scripts/verify-runtime-contract.mjs",
    "verify:shared-catalog-schema": "node scripts/verify-shared-catalog-schema.mjs",
    "risk:classify": "node scripts/ci/classify-risk.mjs",
    "verify:web-environment": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-web-environment.ts",
    "verify:release-template": "node scripts/verify-release-template.mjs",
    "verify:conformance": "node scripts/verify-final-conformance.mjs",
    "security:containers": "node scripts/inspect-container-images.mjs",
    "security:secrets": "node scripts/ci/scan-secrets.mjs",
    "security:semgrep": "semgrep scan --metrics off --jobs 1 --config .semgrep.yml --exclude node_modules --exclude .next --exclude out --exclude src/generated --exclude tests --exclude test-results --exclude playwright-report --exclude docs/archive --exclude fixtures --exclude snapshots --exclude src/components/marketing/legal/legal-html.ts",
    "security:dependencies": "pnpm audit --prod --audit-level high",
    "worker:build": "pnpm prisma:generate && tsc -p tsconfig.worker.json",
    "worker:module-smoke": "pnpm worker:build && node --conditions=react-server .runtime/worker/worker/main.js module-smoke",
    "worker:maintenance-smoke": "pnpm worker:build && node --conditions=react-server .runtime/worker/worker/main.js maintenance-smoke",
    "worker:outbox": "pnpm worker:build && node --conditions=react-server .runtime/worker/worker/main.js outbox-worker",
    "worker:outbox:drain": "pnpm worker:build && node --conditions=react-server .runtime/worker/worker/main.js outbox-drain",
    "worker:outbox:retention": "pnpm worker:build && node --conditions=react-server .runtime/worker/worker/main.js outbox-retention"
  },
  "dependencies": {
    "@ams-data-hub/data-contracts": "workspace:*",
    "@ams-data-hub/realty-contracts": "workspace:*",
    "@ams-data-hub/snapshot-verifier": "workspace:*",
    "@aws-sdk/client-s3": "3.1100.0",
    "@aws-sdk/s3-request-presigner": "3.1100.0",
    "@base-ui/react": "1.8.0",
    "@better-auth/prisma-adapter": "1.7.7",
    "@fontsource/manrope": "5.2.8",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "9.2.4",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "libphonenumber-js": "1.13.14",
    "next": "16.3.8",
    "nuqs": "2.10.1",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.87.0",
    "recharts": "3.10.1",
    "saxes": "6.0.0",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.4",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
